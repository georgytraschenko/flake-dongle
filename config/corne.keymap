/*
 * Anywhy Flake M (46) — раскладка v9, ФАЗА 1 (СТАРТ, без Ukelele/Karabiner)
 * SPDX-License-Identifier: MIT
 *
 * Что работает СРАЗУ, без настройки macOS:
 *   - английский на 100% (буквы, вся пунктуация, символы)
 *   - русские буквы на штатных местах ЙЦУКЕН
 *   - слои, стрелки, нумпад, шорткаты
 * Что НЕ работает до Ukelele:
 *   - русская пунктуация (клавиша точки в RU даёт букву — это лечит Ukelele в Фазе 2)
 *   - (язык уже работает: W+S = English, O+L = Русский, через ⌘F11/⌘F12)
 *
 * Когда освоишься — ставь flake_full.keymap + Ukelele/Karabiner (см. flake_setup.md).
 *
 * Слои: 0 BASE · 1 SYM · 2 NAV · 3 NUM · 4 ADJ
 * Язык: W+S -> ⌘F11 = English · O+L -> ⌘F12 = Русский
 * Пальцы:  левый  ⌥ ⌘ NAV SYM Space   |   правый  ⌫ NUM Enter Raycast(⌃Space) ⌃
 * Позиции: ряд1 0..11 · ряд2 12..23 · ряд3 24..35 · пальцы 36..45
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define NUM  3
#define ADJ  4

&sk { release-after-ms = <2000>; quick-release; };

/ {
    behaviors {
        // тап = липкий Shift (заглавные одной рукой) · зажим = обычный Shift (⇧+стрелки, ⇧+клик)
        hs: hold_or_sticky_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&sk>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_adjust { if-layers = <NAV NUM>; then-layer = <ADJ>; };
    };

    combos {
        compatible = "zmk,combos";
        // W+S (один палец, вертикаль) -> ⌘F11 -> English
        combo_en { timeout-ms = <50>; key-positions = <2 14>;  bindings = <&kp LG(F11)>; layers = <BASE>; };
        // O+L (один палец, вертикаль) -> ⌘F12 -> Русский
        combo_ru { timeout-ms = <50>; key-positions = <9 21>;  bindings = <&kp LG(F12)>; layers = <BASE>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // ───────── 0 · BASE (только буквы) ─────────
        base_layer {
            bindings = <
   &kp TAB      &kp Q      &kp W      &kp E      &kp R      &kp T          &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT
   &kp ESC      &kp A      &kp S      &kp D      &kp F      &kp G          &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
   &hs LSHFT LSHFT &kp Z   &kp X      &kp C      &kp V      &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RBKT
                &kp LALT   &kp LGUI   &mo NAV    &mo SYM    &kp SPACE      &kp BSPC   &mo NUM    &kp RET    &kp LC(SPACE) &kp LCTRL
            >;
        };

        // ───────── 1 · SYM (левый палец → правая рука) ─────────
        // home row = - , . ? ! = · частые символы. Обычные коды (EN верно; RU-пунктуация — после Ukelele).
        sym_layer {
            bindings = <
   &trans       &kp LBKT   &kp RBKT   &kp LBRC   &kp RBRC   &kp TILDE      &kp AT     &kp LPAR   &kp RPAR   &kp DQT    &kp COLON  &kp SEMI
   &kp GRAVE    &kp LT     &kp GT     &kp PIPE   &kp BSLH   &kp CARET      &kp MINUS  &kp COMMA  &kp DOT    &kp QMARK  &kp EXCL   &kp EQUAL
   &kp DLLR     &kp AMPS   &none      &none      &none      &none          &kp PRCNT  &kp UNDER  &kp PLUS   &kp ASTRK  &kp FSLH   &kp HASH
                &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans
            >;
        };

        // ───────── 2 · NAV (левый палец → правая рука) ─────────
        nav_layer {
            bindings = <
   &trans    &kp LG(LS(N4)) &kp LC(LG(SPACE)) &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &kp LG(Z)  &kp LG(LS(Z)) &kp LG(LBKT) &kp LG(RBKT) &kp TAB &kp LS(TAB)
   &kp GRAVE &kp LC(TAB)    &kp LG(G)         &kp LA(TAB)  &kp F20      &kp F21      &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp LG(LEFT) &kp LG(RIGHT)
   &none     &none          &none             &none        &none        &none        &kp LA(LEFT) &kp LA(RIGHT) &kp LC(LEFT) &kp LC(RIGHT) &kp LC(UP) &kp DEL
             &trans         &trans            &trans       &trans       &trans       &trans     &trans     &trans     &trans     &trans
            >;
        };

        // ───────── 3 · NUM (правый палец → левая рука) ─────────
        // Enter/⌫/0 на левой половине (правый палец держит слой). Правая рука пустая.
        num_layer {
            bindings = <
   &kp RET      &kp FSLH   &kp N7     &kp N8     &kp N9     &kp PLUS       &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6
   &kp TAB      &kp ASTRK  &kp N4     &kp N5     &kp N6     &kp MINUS      &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
   &kp BSPC     &kp DOT    &kp N1     &kp N2     &kp N3     &kp COMMA      &none      &none      &none      &none      &none      &none
                &trans     &trans     &trans     &trans     &kp N0         &trans     &trans     &trans     &trans     &trans
            >;
        };

        // ───────── 4 · ADJ (NAV+NUM) ─────────
        adj_layer {
            bindings = <
   &bootloader  &sys_reset &none      &none      &none      &none          &none      &none      &none      &none      &sys_reset &bootloader
   &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR
   &out OUT_TOG &none      &none      &none      &none      &none          &none      &none      &none      &none      &none      &out OUT_TOG
                &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
